<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gridoe.refryt</id>
  <name>Refryt</name>
  <summary>Lightweight YouTube Music client</summary>
  <developer id="io.github.gridoe">
    <name>gridoe</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/gridoe/refryt</url>
  <url type="bugtracker">https://github.com/gridoe/refryt/issues</url>
  <url type="vcs-browser">https://github.com/gridoe/refryt</url>
  <description>
    <p>Refryt is a native desktop client for YouTube Music, written in Rust. There is no browser engine behind it: songs play through mpv, and the app talks to YouTube through the same internal API the website uses. Memory use is typically between 100 and 300 MB, depending on the session.</p>
    <ul>
      <li>Home, Explore, search and your library</li>
      <li>Synced lyrics, an editable queue and music videos</li>
      <li>23 themes, with optional window transparency and background blur</li>
      <li>Media keys and the desktop's media controls</li>
      <li>Downloads for Music Premium accounts</li>
    </ul>
    <p>Refryt is an unofficial client, not affiliated with or endorsed by YouTube or Google.</p>
  </description>
  <launchable type="desktop-id">io.github.gridoe.refryt.desktop</launchable>
